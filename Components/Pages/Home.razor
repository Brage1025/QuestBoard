@page "/"
@rendermode InteractiveServer

@using QuestBoard.Models
@using QuestBoard.Services

@inject QuestService QuestService

<PageTitle>Quest Board</PageTitle>

<div class="container py-4 quest-log-page">

    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>⚔ Quest Log</h1>
            <p class="text-muted mb-0">
                Adventures await those brave enough to accept them.
            </p>
        </div>

        <Button Color="ButtonColor.Primary" @onclick="OpenNewQuestModal">
            + New Quest
        </Button>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>Available</CardTitle>
                    <h2>@AvailableCount</h2>
                </CardBody>
            </Card>
        </div>

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>In Progress</CardTitle>
                    <h2>@InProgressCount</h2>
                </CardBody>
            </Card>
        </div>

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>Completed</CardTitle>
                    <h2>@CompletedCount</h2>
                </CardBody>
            </Card>
        </div>

    </div>

    <div class="mb-3">
        <label for="questSearch" class="form-label">
            Search quests
        </label>

        <input id="questSearch" type="search" class="form-control" placeholder="Search by name or description..."
               @bind="searchText" @bind:event="oninput" />
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">

        <Button Color="@GetFilterButtonColor(QuestFilter.All)" @onclick="() => SetFilter(QuestFilter.All)">
            All
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.Available)" @onclick="() => SetFilter(QuestFilter.Available)">
            Available
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.InProgress)"
                @onclick="() => SetFilter(QuestFilter.InProgress)">
            In Progress
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.Completed)" @onclick="() => SetFilter(QuestFilter.Completed)">
            Completed
        </Button>

    </div>

    <div class="row g-4">

        @if (FilteredQuests.Any())
        {
            @foreach (var quest in FilteredQuests)
            {
                <div class="col-12 col-md-6 col-lg-4" @key="quest.Id">

                    <QuestCard Quest="@quest" StatusChanged="@((QuestStatus status) => UpdateQuestStatus(quest.Id, status))"
                               EditRequested="@OpenEditQuestModal" Deleted="@(() => RequestDeleteQuest(quest))"
                               ObjectiveToggled="@((int objectiveId) => ToggleObjective(quest.Id, objectiveId))"
                               ObjectiveAdded="@((string description) => AddObjective(quest.Id, description))"
                               ObjectiveDeleted="@((int objectiveId) => DeleteObjective(quest.Id, objectiveId))" />

                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <h4>No quests found</h4>
                    <p class="text-muted">
                        Try another search term or select a different filter.
                    </p>
                </div>
            </div>
        }

    </div>

</div>

<Modal @ref="newQuestModal" Title="Create New Quest" IsVerticallyCentered="true">

    <BodyTemplate>
        <EditForm EditContext="newQuestEditContext">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Quest Name</label>
                <InputText @bind-Value="newQuest.Name" class="form-control" />
                <ValidationMessage For="@(() => newQuest.Name)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea @bind-Value="newQuest.Description" class="form-control" rows="3" />
                <ValidationMessage For="@(() => newQuest.Description)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Difficulty</label>
                <InputSelect @bind-Value="newQuest.Difficulty" class="form-select">
                    @foreach (var difficulty in Enum.GetValues<QuestDifficulty>())
                    {
                        <option value="@difficulty">@difficulty</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Reward</label>
                <InputText @bind-Value="newQuest.Reward" class="form-control" />
                <ValidationMessage For="@(() => newQuest.Reward)" />
            </div>
        </EditForm>
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CloseNewQuestModal">
            Cancel
        </Button>

        <Button Color="ButtonColor.Primary" @onclick="SubmitNewQuest">
            Create Quest
        </Button>
    </FooterTemplate>

</Modal>

<Modal @ref="editQuestModal" Title="Edit Quest" IsVerticallyCentered="true">

    <BodyTemplate>
        <EditForm EditContext="editQuestEditContext">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Quest Name</label>
                <InputText @bind-Value="editQuest.Name" class="form-control" />
                <ValidationMessage For="@(() => editQuest.Name)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea @bind-Value="editQuest.Description" class="form-control" rows="3" />
                <ValidationMessage For="@(() => editQuest.Description)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Difficulty</label>
                <InputSelect @bind-Value="editQuest.Difficulty" class="form-select">
                    @foreach (var difficulty in Enum.GetValues<QuestDifficulty>())
                    {
                        <option value="@difficulty">@difficulty</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Reward</label>
                <InputText @bind-Value="editQuest.Reward" class="form-control" />
                <ValidationMessage For="@(() => editQuest.Reward)" />
            </div>
        </EditForm>
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CancelEditQuest">
            Cancel
        </Button>

        <Button Color="ButtonColor.Primary" @onclick="SubmitEditQuest">
            Save Changes
        </Button>
    </FooterTemplate>

</Modal>

<Modal @ref="deleteQuestModal" Title="Delete Quest?" IsVerticallyCentered="true">

    <BodyTemplate>
        <p>
            Are you sure you want to delete
            <strong>@(questToDelete?.Name ?? "this quest")</strong>?
        </p>

        <p class="text-muted mb-0">
            This action cannot be undone.
        </p>
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CancelDelete">
            Cancel
        </Button>

        <Button Color="ButtonColor.Danger" @onclick="ConfirmDelete">
            Yes, Delete
        </Button>
    </FooterTemplate>

</Modal>

@code {
    private List<Quest> Quests => QuestService.GetQuests();

    private int AvailableCount =>
        Quests.Count(q => q.Status == QuestStatus.Available);

    private int InProgressCount =>
        Quests.Count(q => q.Status == QuestStatus.InProgress);

    private int CompletedCount =>
        Quests.Count(q => q.Status == QuestStatus.Completed);

    private string searchText = string.Empty;
    private QuestFilter selectedFilter = QuestFilter.All;

    private IEnumerable<Quest> FilteredQuests
    {
        get
        {
            IEnumerable<Quest> quests = selectedFilter switch
            {
                QuestFilter.Available =>
                    Quests.Where(q => q.Status == QuestStatus.Available),

                QuestFilter.InProgress =>
                    Quests.Where(q => q.Status == QuestStatus.InProgress),

                QuestFilter.Completed =>
                    Quests.Where(q => q.Status == QuestStatus.Completed),

                _ => Quests
            };

            if (string.IsNullOrWhiteSpace(searchText))
            {
                return quests;
            }

            return quests.Where(q =>
                q.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || q.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private Modal newQuestModal = default!;
    private Modal editQuestModal = default!;
    private Modal deleteQuestModal = default!;

    private Quest? questToDelete;

    private Quest newQuest = new()
    {
        Difficulty = QuestDifficulty.Medium,
        Status = QuestStatus.Available
    };

    private Quest editQuest = new();

    private EditContext newQuestEditContext = default!;
    private EditContext editQuestEditContext = default!;

    protected override void OnInitialized()
    {
        newQuestEditContext = new EditContext(newQuest);
        editQuestEditContext = new EditContext(editQuest);
    }

    private void SetFilter(QuestFilter filter)
    {
        selectedFilter = filter;
    }

    private ButtonColor GetFilterButtonColor(QuestFilter filter)
    {
        return selectedFilter == filter
            ? ButtonColor.Primary
            : ButtonColor.Secondary;
    }

    private async Task OpenNewQuestModal()
    {
        newQuest = new Quest
        {
            Difficulty = QuestDifficulty.Medium,
            Status = QuestStatus.Available
        };

        newQuestEditContext = new EditContext(newQuest);
        await newQuestModal.ShowAsync();
    }

    private async Task SubmitNewQuest()
    {
        if (newQuestEditContext.Validate())
        {
            QuestService.AddQuest(newQuest);

            newQuest = new Quest
            {
                Difficulty = QuestDifficulty.Medium,
                Status = QuestStatus.Available
            };

            newQuestEditContext = new EditContext(newQuest);
            await newQuestModal.HideAsync();
        }
    }

    private async Task CloseNewQuestModal()
    {
        await newQuestModal.HideAsync();
    }

    private async Task OpenEditQuestModal(Quest quest)
    {
        editQuest = new Quest
        {
            Id = quest.Id,
            Name = quest.Name,
            Description = quest.Description,
            Difficulty = quest.Difficulty,
            Status = quest.Status,
            Reward = quest.Reward,
            Objectives = quest.Objectives
        };

        editQuestEditContext = new EditContext(editQuest);
        await editQuestModal.ShowAsync();
    }

    private async Task SubmitEditQuest()
    {
        if (editQuestEditContext.Validate())
        {
            QuestService.UpdateQuest(editQuest);
            await editQuestModal.HideAsync();
        }
    }

    private async Task CancelEditQuest()
    {
        await editQuestModal.HideAsync();
    }

    private void UpdateQuestStatus(int questId, QuestStatus status)
    {
        QuestService.UpdateStatus(questId, status);
    }

    private void ToggleObjective(int questId, int objectiveId)
    {
        QuestService.ToggleObjective(questId, objectiveId);
    }

    private void AddObjective(int questId, string description)
    {
        QuestService.AddObjective(questId, description);
    }

    private void DeleteObjective(int questId, int objectiveId)
    {
        QuestService.DeleteObjective(questId, objectiveId);
    }

    private async Task RequestDeleteQuest(Quest quest)
    {
        questToDelete = quest;
        await deleteQuestModal.ShowAsync();
    }

    private async Task ConfirmDelete()
    {
        if (questToDelete is not null)
        {
            QuestService.DeleteQuest(questToDelete.Id);
            questToDelete = null;
        }

        await deleteQuestModal.HideAsync();
    }

    private async Task CancelDelete()
    {
        questToDelete = null;
        await deleteQuestModal.HideAsync();
    }

    private enum QuestFilter
    {
        All,
        Available,
        InProgress,
        Completed
    }
}