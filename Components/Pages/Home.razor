@page "/"
@rendermode InteractiveServer

@using QuestBoard.Models
@using QuestBoard.Services

@inject QuestService QuestService

<PageTitle>Quest Board</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>⚔ Quest Board</h1>
            <p class="text-muted mb-0">
                Adventures await those brave enough to accept them.
            </p>
        </div>

        <Button Color="ButtonColor.Primary" @onclick="OpenNewQuestModal">
            + New Quest
        </Button>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>Available</CardTitle>
                    <h2>@AvailableCount</h2>
                </CardBody>
            </Card>
        </div>

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>In Progress</CardTitle>
                    <h2>@InProgressCount</h2>
                </CardBody>
            </Card>
        </div>

        <div class="col-md-4">
            <Card>
                <CardBody>
                    <CardTitle>Completed</CardTitle>
                    <h2>@CompletedCount</h2>
                </CardBody>
            </Card>
        </div>

    </div>

    <!-- Quest filters -->
    <div class="d-flex gap-2 mb-4">

        <Button Color="@GetFilterButtonColor(QuestFilter.All)" @onclick="() => SetFilter(QuestFilter.All)">
            All
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.Available)" @onclick="() => SetFilter(QuestFilter.Available)">
            Available
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.InProgress)"
                @onclick="() => SetFilter(QuestFilter.InProgress)">
            In Progress
        </Button>

        <Button Color="@GetFilterButtonColor(QuestFilter.Completed)" @onclick="() => SetFilter(QuestFilter.Completed)">
            Completed
        </Button>

    </div>

    <!-- Quest cards -->
    <div class="row g-4">

        @foreach (var quest in FilteredQuests)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <QuestCard Quest="@quest" StatusChanged="@((QuestStatus status) => UpdateQuestStatus(quest.Id, status))"
                           Deleted="@(() => DeleteQuest(quest.Id))" />

            </div>
        }

    </div>

</div>

<Modal @ref="newQuestModal" Title="Create New Quest" IsVerticallyCentered="true">

    <BodyTemplate>

        <EditForm EditContext="newQuestEditContext" OnValidSubmit="CreateQuest">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Quest Name</label>

                <InputText @bind-Value="newQuest.Name" class="form-control" />

                <ValidationMessage For="@(() => newQuest.Name)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>

                <InputTextArea @bind-Value="newQuest.Description" class="form-control" rows="3" />

                <ValidationMessage For="@(() => newQuest.Description)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Difficulty</label>

                <InputSelect @bind-Value="newQuest.Difficulty" class="form-select">

                    @foreach (var difficulty in Enum.GetValues<QuestDifficulty>())
                    {
                        <option value="@difficulty">
                            @difficulty
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Reward</label>

                <InputText @bind-Value="newQuest.Reward" class="form-control" />

                <ValidationMessage For="@(() => newQuest.Reward)" />
            </div>

        </EditForm>

    </BodyTemplate>

    <FooterTemplate>

        <Button Color="ButtonColor.Secondary" @onclick="CloseNewQuestModal">
            Cancel
        </Button>

        <Button Color="ButtonColor.Primary" @onclick="SubmitNewQuest">
            Create Quest
        </Button>

    </FooterTemplate>

</Modal>

@code {

    private List<Quest> Quests => QuestService.GetQuests();

    private int AvailableCount =>
        Quests.Count(q => q.Status == QuestStatus.Available);

    private int InProgressCount =>
        Quests.Count(q => q.Status == QuestStatus.InProgress);

    private int CompletedCount =>
        Quests.Count(q => q.Status == QuestStatus.Completed);

    private QuestFilter selectedFilter = QuestFilter.All;

    private IEnumerable<Quest> FilteredQuests =>
        selectedFilter switch
        {
            QuestFilter.Available =>
                Quests.Where(q => q.Status == QuestStatus.Available),

            QuestFilter.InProgress =>
                Quests.Where(q => q.Status == QuestStatus.InProgress),

            QuestFilter.Completed =>
                Quests.Where(q => q.Status == QuestStatus.Completed),

            _ => Quests
        };

    private Modal newQuestModal = default!;

    private Quest newQuest = new()
    {
        Difficulty = QuestDifficulty.Medium,
        Status = QuestStatus.Available
    };

    private EditContext newQuestEditContext = default!;

    protected override void OnInitialized()
    {
        newQuestEditContext = new EditContext(newQuest);
    }

    private void SetFilter(QuestFilter filter)
    {
        selectedFilter = filter;
    }

    private ButtonColor GetFilterButtonColor(QuestFilter filter)
    {
        return selectedFilter == filter
            ? ButtonColor.Primary
            : ButtonColor.Secondary;
    }

    private async Task OpenNewQuestModal()
    {
        newQuest = new Quest
        {
            Difficulty = QuestDifficulty.Medium,
            Status = QuestStatus.Available
        };

        newQuestEditContext = new EditContext(newQuest);

        await newQuestModal.ShowAsync();
    }

    private async Task SubmitNewQuest()
    {
        if (newQuestEditContext.Validate())
        {
            await CreateQuest();
        }
    }

    private async Task CreateQuest()
    {
        QuestService.AddQuest(newQuest);

        newQuest = new Quest
        {
            Difficulty = QuestDifficulty.Medium,
            Status = QuestStatus.Available
        };

        newQuestEditContext = new EditContext(newQuest);

        await newQuestModal.HideAsync();
    }

    private async Task CloseNewQuestModal()
    {
        await newQuestModal.HideAsync();
    }

    private void UpdateQuestStatus(int questId, QuestStatus status)
    {
        QuestService.UpdateStatus(questId, status);
    }

    private void DeleteQuest(int questId)
    {
        QuestService.DeleteQuest(questId);
    }

    private enum QuestFilter
    {
        All,
        Available,
        InProgress,
        Completed
    }
}